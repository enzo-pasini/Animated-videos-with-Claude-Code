# dependencies (reinstall with: npm install / the .venv setup)
node_modules/
.venv/
.venv-tts/

# renders and scratch output (re-render with Remotion; the locked v3 lives in style_lock/)
out/

# Python cache
__pycache__/
*.pyc

# reference channel downloads: large and not ours (re-download with yt-dlp from references/meta/urls.txt)
references/videos/
references/meta/info/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini

# licensed music from the YouTube Audio Library (decision D7): not ours to redistribute
assets/music/*
!assets/music/README.md
!assets/music/ATTRIBUTION.md

# generated by tools/build_props.py (rebuild any time)
render_props.json
# per-episode audio copied for Remotion staticFile
public/episodes/
# test renders of fixture plans
tools/tests/**/storyboard/

# D13: per-video media stays out of git (text files stay in): voice, music, mixes, renders, stills
videos/**/*.wav
videos/**/*.mp3
videos/**/*.m4a
videos/**/*.ogg
videos/**/*.mp4
videos/**/storyboard/
videos/**/analysis_run/
videos/**/*.jpg
videos/**/*.png

# skill-creator test runs (outputs, grading, viewer): regenerated per iteration
.claude/skills/generate-animated-shorts-workspace/

# skill-creator test runs of explain-find-feedback
.claude/skills/explain-find-feedback-workspace/

# VFX reference downloads (other channels, never in git)
references/effects/videos/
references/effects/frames/

# sound effects (user's files, some from games: not ours to redistribute; see assets/sound-effects/README.md)
assets/sound-effects/*
!assets/sound-effects/README.md

# free 3D packs (scenes plan 3): downloaded per theme, not ours to redistribute in the repo; license + sources stay tracked
public/packs/*/*
!public/packs/*/LICENSE.txt
!public/packs/*/sources.txt

# REFERENCE-ONLY models (look and learn, never loaded by a set or a video; e.g. CC-BY Mountain Cabin, scenes plan 4)
public/reference-only/*/*
!public/reference-only/README.md
!public/reference-only/*/sources.txt

# public snapshot: third-party reference material (frames, transcripts, video list) stays private
references/analysis/contact_sheets/
references/analysis/style_frames/
references/transcripts/
references/meta/
references/sets/castle_abc.jpg
style_lock/comparison_sheet_v*.jpg
style_lock/history/comparison_sheet_v*.jpg
